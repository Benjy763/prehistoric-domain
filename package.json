{
  "name": "prehistoric-domain",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "copy:assets": "cpx ./src/assets/**/*.* ./dist/assets",
    "build:scene": "cross-env MAIN_SCENE=$npm_config_mainscene NODE_ENV=production webpack",
    "build:scene:all": "node build-all.js",
    "build:all": "npm run copy:assets & npm run build:scene:all",
    "build:ws": "cross-env NODE_ENV=production webpack --config webpack-ws.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "npm:audit": "npm audit",
    "npm:audit:fix": "npm audit fix --force",
    "start": "cross-env MAIN_SCENE='home' webpack-dev-server --https --config webpack-dev.config.js --host 0.0.0.0 --progress --colors --hot-only --inline --port 8080",
    "start:ws": "webpack-dev-server --config webpack-dev-ws.config.js --host 0.0.0.0 --progress --colors --hot-only --inline --port 8080",
    "prepare": "husky install"
  },
  "dependencies": {
    "aframe": "^1.5.0",
    "aframe-curve-component": "^0.1.3",
    "aframe-extras": "^7.1.0",
    "aframe-fps-counter-component": "^1.0.1",
    "aframe-fps-look-controls-component": "^1.1.0",
    "aframe-particle-system-component": "^1.1.3",
    "aframe-physics-system": "github:n5ro/aframe-physics-system",
    "aframe-super-hot-html-loader": "*",
    "aframe-super-hot-loader": "*",
    "jquery": "^3.6.0",
    "super-hands": "^3.0.2"
  },
  "semistandard": {
    "globals": [
      "AFRAME",
      "THREE"
    ],
    "ignore": [
      "build/**"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@eslint/js": "^9.11.1",
    "babel-loader": "^9.1.3",
    "babel-plugin-istanbul": "^6.1.1",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.1",
    "globals": "^15.9.0",
    "husky": "^8.0.0",
    "jsdom": "^24.0.0",
    "jsdom-global": "^3.0.2",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "style-loader": "^4.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "engines": {
    "node": ">= 4.6.0",
    "npm": ">= 2.15.9"
  }
}
